{
  "manifest_version": 3,
  "name": "Claude Project Downloader",
  "version": "1.1.0",
  "description": "Download all files from Claude projects and export conversations as Markdown",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "index.html",
    "default_title": "Claude Project Downloader",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["https://claude.ai/*"]
}
